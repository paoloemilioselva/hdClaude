<?xml version="1.0"?>
<materialx version="1.39">

  <!--
    hdClaude genglsl_pt implementations of the MaterialX pbrlib closure nodes.

    Version of record: MaterialX 1.39.3, the version inside OpenUSD 26.03.

    THE OVERRIDE SET IS NOT OPTIONAL AND NOT PARTIAL.

    MaterialX resolves a source file's #include relative to that file's own
    directory, so an upstream pbrlib closure resolves lib/mx_closure_type.glsl
    to *upstream's* copy. Generating one upstream closure beside one hdClaude
    closure emits both and declares struct ClosureData twice.

    The set is exactly the pbrlib GLSL files that include mx_closure_type.glsl:
    22 files in 1.39.3, listed below. No stdlib file includes it, which is what
    keeps the inheritance boundary clean.

    NODEDEF NAMES DO NOT FOLLOW FILE NAMES. mx_multiply_bsdf_color3.glsl is
    declared for ND_multiply_bsdfC, not ND_multiply_bsdf_color3. A declaration
    naming a nodedef that does not exist is ignored SILENTLY: MaterialX uses
    the stock implementation, and the only symptom is the duplicate ClosureData
    above. The nodedef names here are taken verbatim from the stock
    pbrlib_genglsl_impl.mtlx, and tests/materialx_tests.cpp asserts that every
    one of them resolves.
  -->

  <!-- ====================================================================== -->
  <!-- Surface: the calling convention                                        -->
  <!--                                                                        -->
  <!-- Bodiless by design, exactly as the stock declaration is: implemented    -->
  <!-- in C++ by hdclaude::PathTracerSurfaceNode, which evaluates the BSDF     -->
  <!-- and EDF against the caller-supplied closureData instead of building     -->
  <!-- its own inside a light loop.                                            -->
  <!-- ====================================================================== -->

  <implementation name="IM_surface_genglsl_pt"
                  nodedef="ND_surface"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Diffuse                                                                -->
  <!-- ====================================================================== -->

  <implementation name="IM_oren_nayar_diffuse_bsdf_genglsl_pt"
                  nodedef="ND_oren_nayar_diffuse_bsdf"
                  file="mx_oren_nayar_diffuse_bsdf.glsl"
                  function="mx_oren_nayar_diffuse_bsdf"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Specular                                                               -->
  <!-- ====================================================================== -->

  <implementation name="IM_conductor_bsdf_genglsl_pt"
                  nodedef="ND_conductor_bsdf"
                  file="mx_conductor_bsdf.glsl"
                  function="mx_conductor_bsdf"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Combinators                                                            -->
  <!-- ====================================================================== -->

  <implementation name="IM_mix_bsdf_genglsl_pt"
                  nodedef="ND_mix_bsdf"
                  file="mx_mix_bsdf.glsl"
                  function="mx_mix_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_add_bsdf_genglsl_pt"
                  nodedef="ND_add_bsdf"
                  file="mx_add_bsdf.glsl"
                  function="mx_add_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_layer_bsdf_genglsl_pt"
                  nodedef="ND_layer_bsdf"
                  file="mx_layer_bsdf.glsl"
                  function="mx_layer_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_multiply_bsdfC_genglsl_pt"
                  nodedef="ND_multiply_bsdfC"
                  file="mx_multiply_bsdf_color3.glsl"
                  function="mx_multiply_bsdf_color3"
                  target="genglsl_pt" />

  <implementation name="IM_multiply_bsdfF_genglsl_pt"
                  nodedef="ND_multiply_bsdfF"
                  file="mx_multiply_bsdf_float.glsl"
                  function="mx_multiply_bsdf_float"
                  target="genglsl_pt" />

  <!--
    ====================================================================
    STILL TO OVERRIDE - 15 files. Phase 4 in docs/roadmap.md.
    ====================================================================

    Generation cannot succeed for a material using any of these until the
    override exists, for the reason at the top of this file.

      mx_add_edf.glsl                    ND_add_edf
      mx_anisotropic_vdf.glsl            ND_anisotropic_vdf
      mx_burley_diffuse_bsdf.glsl        ND_burley_diffuse_bsdf
      mx_chiang_hair_bsdf.glsl           ND_chiang_hair_bsdf, ND_deon_hair_absorption_from_melanin, ND_chiang_hair_absorption_from_color, ND_chiang_hair_roughness
      mx_dielectric_bsdf.glsl            ND_dielectric_bsdf
      mx_generalized_schlick_bsdf.glsl   ND_generalized_schlick_bsdf
      mx_generalized_schlick_edf.glsl    ND_generalized_schlick_edf
      mx_layer_vdf.glsl                  ND_layer_vdf
      mx_mix_edf.glsl                    ND_mix_edf
      mx_multiply_edf_color3.glsl        ND_multiply_edfC
      mx_multiply_edf_float.glsl         ND_multiply_edfF
      mx_sheen_bsdf.glsl                 ND_sheen_bsdf
      mx_subsurface_bsdf.glsl            ND_subsurface_bsdf
      mx_translucent_bsdf.glsl           ND_translucent_bsdf
      mx_uniform_edf.glsl                ND_uniform_edf
  -->

</materialx>
