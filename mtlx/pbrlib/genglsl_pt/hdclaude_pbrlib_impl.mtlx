<?xml version="1.0"?>
<materialx version="1.39">

  <!--
    hdClaude genglsl_pt implementations of the MaterialX pbrlib closure nodes.

    Version of record: MaterialX 1.39.3, the version inside OpenUSD 26.03.

    THE OVERRIDE SET IS NOT OPTIONAL AND NOT PARTIAL.

    MaterialX resolves a source file's #include relative to that file's own
    directory, so an upstream pbrlib closure resolves lib/mx_closure_type.glsl
    to *upstream's* copy. Generating one upstream closure beside one hdClaude
    closure emits both and declares struct ClosureData twice.

    The set is exactly the pbrlib GLSL files that include mx_closure_type.glsl:
    22 files in 1.39.3, listed below. No stdlib file includes it, which is what
    keeps the inheritance boundary clean.

    NODEDEF NAMES DO NOT FOLLOW FILE NAMES. mx_multiply_bsdf_color3.glsl is
    declared for ND_multiply_bsdfC, not ND_multiply_bsdf_color3. A declaration
    naming a nodedef that does not exist is ignored SILENTLY: MaterialX uses
    the stock implementation, and the only symptom is the duplicate ClosureData
    above. The nodedef names here are taken verbatim from the stock
    pbrlib_genglsl_impl.mtlx, and tests/materialx_tests.cpp asserts that every
    one of them resolves.
  -->

  <!-- ====================================================================== -->
  <!-- Surface: the calling convention                                        -->
  <!--                                                                        -->
  <!-- Bodiless by design, exactly as the stock declaration is: implemented    -->
  <!-- in C++ by hdclaude::PathTracerSurfaceNode, which evaluates the BSDF     -->
  <!-- and EDF against the caller-supplied closureData instead of building     -->
  <!-- its own inside a light loop.                                            -->
  <!-- ====================================================================== -->

  <implementation name="IM_surface_genglsl_pt"
                  nodedef="ND_surface"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Diffuse                                                                -->
  <!-- ====================================================================== -->

  <implementation name="IM_oren_nayar_diffuse_bsdf_genglsl_pt"
                  nodedef="ND_oren_nayar_diffuse_bsdf"
                  file="mx_oren_nayar_diffuse_bsdf.glsl"
                  function="mx_oren_nayar_diffuse_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_burley_diffuse_bsdf_genglsl_pt"
                  nodedef="ND_burley_diffuse_bsdf"
                  file="mx_burley_diffuse_bsdf.glsl"
                  function="mx_burley_diffuse_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_translucent_bsdf_genglsl_pt"
                  nodedef="ND_translucent_bsdf"
                  file="mx_translucent_bsdf.glsl"
                  function="mx_translucent_bsdf"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Specular and transmissive                                              -->
  <!-- ====================================================================== -->

  <implementation name="IM_conductor_bsdf_genglsl_pt"
                  nodedef="ND_conductor_bsdf"
                  file="mx_conductor_bsdf.glsl"
                  function="mx_conductor_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_dielectric_bsdf_genglsl_pt"
                  nodedef="ND_dielectric_bsdf"
                  file="mx_dielectric_bsdf.glsl"
                  function="mx_dielectric_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_generalized_schlick_bsdf_genglsl_pt"
                  nodedef="ND_generalized_schlick_bsdf"
                  file="mx_generalized_schlick_bsdf.glsl"
                  function="mx_generalized_schlick_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_sheen_bsdf_genglsl_pt"
                  nodedef="ND_sheen_bsdf"
                  file="mx_sheen_bsdf.glsl"
                  function="mx_sheen_bsdf"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Subsurface and hair                                                    -->
  <!-- ====================================================================== -->

  <implementation name="IM_subsurface_bsdf_genglsl_pt"
                  nodedef="ND_subsurface_bsdf"
                  file="mx_subsurface_bsdf.glsl"
                  function="mx_subsurface_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_chiang_hair_bsdf_genglsl_pt"
                  nodedef="ND_chiang_hair_bsdf"
                  file="mx_chiang_hair_bsdf.glsl"
                  function="mx_chiang_hair_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_deon_hair_absorption_from_melanin_genglsl_pt"
                  nodedef="ND_deon_hair_absorption_from_melanin"
                  file="mx_chiang_hair_bsdf.glsl"
                  function="mx_deon_hair_absorption_from_melanin"
                  target="genglsl_pt" />

  <implementation name="IM_chiang_hair_absorption_from_color_genglsl_pt"
                  nodedef="ND_chiang_hair_absorption_from_color"
                  file="mx_chiang_hair_bsdf.glsl"
                  function="mx_chiang_hair_absorption_from_color"
                  target="genglsl_pt" />

  <implementation name="IM_chiang_hair_roughness_genglsl_pt"
                  nodedef="ND_chiang_hair_roughness"
                  file="mx_chiang_hair_bsdf.glsl"
                  function="mx_chiang_hair_roughness"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Emission                                                               -->
  <!-- ====================================================================== -->

  <implementation name="IM_uniform_edf_genglsl_pt"
                  nodedef="ND_uniform_edf"
                  file="mx_uniform_edf.glsl"
                  function="mx_uniform_edf"
                  target="genglsl_pt" />

  <implementation name="IM_generalized_schlick_edf_genglsl_pt"
                  nodedef="ND_generalized_schlick_edf"
                  file="mx_generalized_schlick_edf.glsl"
                  function="mx_generalized_schlick_edf"
                  target="genglsl_pt" />

  <implementation name="IM_add_edf_genglsl_pt"
                  nodedef="ND_add_edf"
                  file="mx_add_edf.glsl"
                  function="mx_add_edf"
                  target="genglsl_pt" />

  <implementation name="IM_mix_edf_genglsl_pt"
                  nodedef="ND_mix_edf"
                  file="mx_mix_edf.glsl"
                  function="mx_mix_edf"
                  target="genglsl_pt" />

  <implementation name="IM_multiply_edfC_genglsl_pt"
                  nodedef="ND_multiply_edfC"
                  file="mx_multiply_edf_color3.glsl"
                  function="mx_multiply_edf_color3"
                  target="genglsl_pt" />

  <implementation name="IM_multiply_edfF_genglsl_pt"
                  nodedef="ND_multiply_edfF"
                  file="mx_multiply_edf_float.glsl"
                  function="mx_multiply_edf_float"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Volume                                                                 -->
  <!-- ====================================================================== -->

  <implementation name="IM_anisotropic_vdf_genglsl_pt"
                  nodedef="ND_anisotropic_vdf"
                  file="mx_anisotropic_vdf.glsl"
                  function="mx_anisotropic_vdf"
                  target="genglsl_pt" />

  <implementation name="IM_layer_vdf_genglsl_pt"
                  nodedef="ND_layer_vdf"
                  file="mx_layer_vdf.glsl"
                  function="mx_layer_vdf"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Combinators                                                            -->
  <!--                                                                        -->
  <!-- These carry the sampling correctness of the whole target. A closure    -->
  <!-- primitive that samples slightly wrong produces slightly wrong shading; -->
  <!-- a combinator that reports the selected child density instead of the -->
  <!-- mixture density makes every MIS weight in the renderer wrong.          -->
  <!-- ====================================================================== -->

  <implementation name="IM_mix_bsdf_genglsl_pt"
                  nodedef="ND_mix_bsdf"
                  file="mx_mix_bsdf.glsl"
                  function="mx_mix_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_add_bsdf_genglsl_pt"
                  nodedef="ND_add_bsdf"
                  file="mx_add_bsdf.glsl"
                  function="mx_add_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_layer_bsdf_genglsl_pt"
                  nodedef="ND_layer_bsdf"
                  file="mx_layer_bsdf.glsl"
                  function="mx_layer_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_multiply_bsdfC_genglsl_pt"
                  nodedef="ND_multiply_bsdfC"
                  file="mx_multiply_bsdf_color3.glsl"
                  function="mx_multiply_bsdf_color3"
                  target="genglsl_pt" />

  <implementation name="IM_multiply_bsdfF_genglsl_pt"
                  nodedef="ND_multiply_bsdfF"
                  file="mx_multiply_bsdf_float.glsl"
                  function="mx_multiply_bsdf_float"
                  target="genglsl_pt" />

  <!--
    ====================================================================
    STILL TO OVERRIDE - 0 files.
    ====================================================================

    Generation cannot succeed for a material using any of these until the
    override exists, for the reason at the top of this file.

  -->

</materialx>
