<?xml version="1.0"?>
<materialx version="1.39">

  <!--
    hdClaude genglsl_pt implementations of the MaterialX pbrlib closure nodes.

    THE OVERRIDE SET IS NOT OPTIONAL AND NOT PARTIAL.

    Every pbrlib GLSL source file that includes `lib/mx_closure_type.glsl` must
    be overridden here, because that include is resolved relative to the
    including file's own directory. If a single upstream pbrlib closure is
    generated alongside an hdClaude one, both `lib/mx_closure_type.glsl` files
    are emitted and `struct ClosureData` is declared twice ; a compile error,
    which is the right failure mode, but a hard one.

    In MaterialX 1.39 that set is exactly 22 files, enumerated below. No stdlib
    file includes `mx_closure_type.glsl`, which is what makes the boundary
    clean: hdClaude overrides the closures and inherits every pattern, math,
    colour, and procedural node from `genglsl` unchanged.

    Progress: 7 of 22. The remaining 15 are listed at the end of this file and
    are tracked as phase 4 in docs/roadmap.md. Generation will not succeed until
    all 22 are present; this file is committed incomplete on purpose, so the
    boundary is recorded rather than rediscovered.
  -->

  <!-- ====================================================================== -->
  <!-- Diffuse                                                                 -->
  <!-- ====================================================================== -->

  <implementation name="IM_oren_nayar_diffuse_bsdf_genglsl_pt"
                  nodedef="ND_oren_nayar_diffuse_bsdf"
                  file="mx_oren_nayar_diffuse_bsdf.glsl"
                  function="mx_oren_nayar_diffuse_bsdf"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Specular                                                                -->
  <!-- ====================================================================== -->

  <implementation name="IM_conductor_bsdf_genglsl_pt"
                  nodedef="ND_conductor_bsdf"
                  file="mx_conductor_bsdf.glsl"
                  function="mx_conductor_bsdf"
                  target="genglsl_pt" />

  <!-- ====================================================================== -->
  <!-- Combinators                                                             -->
  <!--                                                                         -->
  <!-- These carry the sampling correctness of the whole target. A closure     -->
  <!-- primitive that samples slightly wrong produces slightly wrong shading;  -->
  <!-- a combinator that reports the selected child's density instead of the   -->
  <!-- mixture density makes every MIS weight in the renderer wrong, in a way  -->
  <!-- that survives convergence and is invisible in an image.                 -->
  <!-- ====================================================================== -->

  <implementation name="IM_mix_bsdf_genglsl_pt"
                  nodedef="ND_mix_bsdf"
                  file="mx_mix_bsdf.glsl"
                  function="mx_mix_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_add_bsdf_genglsl_pt"
                  nodedef="ND_add_bsdf"
                  file="mx_add_bsdf.glsl"
                  function="mx_add_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_layer_bsdf_genglsl_pt"
                  nodedef="ND_layer_bsdf"
                  file="mx_layer_bsdf.glsl"
                  function="mx_layer_bsdf"
                  target="genglsl_pt" />

  <implementation name="IM_multiply_bsdf_color3_genglsl_pt"
                  nodedef="ND_multiply_bsdf_color3"
                  file="mx_multiply_bsdf_color3.glsl"
                  function="mx_multiply_bsdf_color3"
                  target="genglsl_pt" />

  <implementation name="IM_multiply_bsdf_float_genglsl_pt"
                  nodedef="ND_multiply_bsdf_float"
                  file="mx_multiply_bsdf_float.glsl"
                  function="mx_multiply_bsdf_float"
                  target="genglsl_pt" />

  <!--
    ========================================================================
    STILL TO OVERRIDE - 15 remaining. Phase 4 in docs/roadmap.md.
    ========================================================================

    BSDF primitives:
      ND_burley_diffuse_bsdf         mx_burley_diffuse_bsdf.glsl
      ND_translucent_bsdf            mx_translucent_bsdf.glsl
      ND_dielectric_bsdf             mx_dielectric_bsdf.glsl
      ND_generalized_schlick_bsdf    mx_generalized_schlick_bsdf.glsl
      ND_subsurface_bsdf             mx_subsurface_bsdf.glsl
      ND_sheen_bsdf                  mx_sheen_bsdf.glsl
      ND_chiang_hair_bsdf            mx_chiang_hair_bsdf.glsl

    EDFs - emission needs no direction sampling, so these are the cheapest of
    the set; they exist in it only because of the shared ClosureData include:
      ND_uniform_edf                 mx_uniform_edf.glsl
      ND_generalized_schlick_edf     mx_generalized_schlick_edf.glsl
      ND_add_edf                     mx_add_edf.glsl
      ND_mix_edf                     mx_mix_edf.glsl
      ND_multiply_edf_color3         mx_multiply_edf_color3.glsl
      ND_multiply_edf_float          mx_multiply_edf_float.glsl

    VDFs - homogeneous interior media only; heterogeneous volumes are not
    scheduled (docs/roadmap.md, open question 4):
      ND_anisotropic_vdf             mx_anisotropic_vdf.glsl
      ND_layer_vdf                   mx_layer_vdf.glsl
  -->

</materialx>
