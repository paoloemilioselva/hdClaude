<?xml version="1.0"?>
<materialx version="1.39">

  <!--
    hdClaude path-tracing GLSL target.

    Derives from the stock `genglsl` target, which is MaterialX's documented
    mechanism for specialising a code generation target (`essl` and `genmsl`
    relate to `genglsl` the same way). Inheritance is what makes hdClaude's
    shading commitment affordable: every node hdClaude does not explicitly
    override ; the whole of stdlib, every pattern, math, colour, and
    procedural node ; is generated by unmodified upstream MaterialX.

    hdClaude overrides only the `pbrlib` closure nodes, and only to add
    importance sampling and PDF evaluation, which a rasterisation target has no
    need to emit. See docs/materialx-codegen.md.
  -->
  <targetdef name="genglsl_pt" inherit="genglsl" />

</materialx>
