/// hdClaude's settings for Houdini. Generated by
/// scripts/generate_houdini_parameters.py from the delegate's render setting
/// descriptors; edit that script or the delegate, not this file.
///
/// The Render Settings LOP, which authors each setting on the RenderSettings prim when its control says so.

#include "$HFS/houdini/soho/parameters/CommonMacros.ds"
{
    name    "hdClaude"
    label   "Claude GPU Path Tracer"
    parmtag { spare_opfilter "!!SHOP/PROPERTIES!!" }
    parmtag { spare_classtags "render" }

    parm {
        name    "samplesPerPixel_control"
        label   "Samples per pixel"
        type    string
        default { "none" }
        menujoin {
            [ "import loputils" ]
            [ "return loputils.createEditPropertiesControlMenu(kwargs, 'int')" ]
            language python
        }
        parmtag { "sidefx::look" "icon" }
    }
    parm {
        name    "samplesPerPixel"
        label   "Samples per pixel"
        type    int
        size    1
        default { 64 }
        parmtag { "spare_category" "Sampling" }
        parmtag { "usdvaluetype" "int" }
        disablewhen "{ samplesPerPixel_control == block } { samplesPerPixel_control == none }"
    }
