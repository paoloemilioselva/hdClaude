/// hdClaude's settings for Houdini. Generated by
/// scripts/generate_houdini_parameters.py from the delegate's render setting
/// descriptors; edit that script or the delegate, not this file.
///
/// The viewport's Display Options (uiscope viewport).

#include "$HFS/houdini/soho/parameters/CommonMacros.ds"
{
    name    "hdClaude"
    label   "Claude GPU Path Tracer"
    parmtag { spare_opfilter "!!SHOP/PROPERTIES!!" }
    parmtag { spare_classtags "render" }

    parm {
        name    "samplesPerPixel"
        label   "Samples per pixel"
        type    int
        size    1
        default { 64 }
        parmtag { "spare_category" "Sampling" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "samplesPerFrame"
        label   "Samples per frame"
        type    int
        size    1
        default { 4 }
        parmtag { "spare_category" "Sampling" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "maxBounces"
        label   "Max bounces"
        type    int
        size    1
        default { 8 }
        parmtag { "spare_category" "Sampling" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "exposure"
        label   "Exposure"
        type    float
        size    1
        default { 0.0 }
        parmtag { "spare_category" "Lighting" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
    }
    parm {
        name    "environmentIntensity"
        label   "Environment intensity"
        type    float
        size    1
        default { 1.0 }
        parmtag { "spare_category" "Lighting" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
    }
    parm {
        name    "sunIntensity"
        label   "Sun intensity"
        type    float
        size    1
        default { 1.0 }
        parmtag { "spare_category" "Lighting" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
    }
    parm {
        name    "upAxis"
        label   "Up axis"
        type    string
        size    1
        default { "Y" }
        parmtag { "spare_category" "Lighting" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
        menu {
            "Y" "Y"
            "Z" "Z"
        }
    }
    parm {
        name    "lightGeometry"
        label   "Light geometry"
        type    toggle
        size    1
        default { 0 }
        parmtag { "spare_category" "Lighting" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }
    parm {
        name    "subdivisionLevel"
        label   "Subdivision level"
        type    int
        size    1
        default { 2 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "adaptiveSubdivision"
        label   "Adaptive subdivision"
        type    toggle
        size    1
        default { 0 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }
    parm {
        name    "perFaceSubdivision"
        label   "Per-face subdivision"
        type    toggle
        size    1
        default { 0 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }
    parm {
        name    "subdivisionEdgePixels"
        label   "Subdivision edge pixels"
        type    float
        size    1
        default { 4.0 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
    }
    parm {
        name    "subdivisionOffScreenLevel"
        label   "Off-screen subdivision level"
        type    int
        size    1
        default { 1 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "subdivisionFaceBudget"
        label   "Subdivision face budget"
        type    int
        size    1
        default { 4194304 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "subdivisionFollowsCamera"
        label   "Subdivision follows camera"
        type    toggle
        size    1
        default { 0 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }
    parm {
        name    "retessellate"
        label   "Retessellate"
        type    int
        size    1
        default { 0 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "curveGeometry"
        label   "Curve geometry"
        type    string
        size    1
        default { "implicit" }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
        menu {
            "implicit" "implicit"
            "swept" "swept"
        }
    }
    parm {
        name    "curveSides"
        label   "Curve sides"
        type    int
        size    1
        default { 6 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "curveSegmentSamples"
        label   "Curve segment samples"
        type    int
        size    1
        default { 1 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "sphereRadial"
        label   "Sphere radial divisions"
        type    int
        size    1
        default { 10 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "sphereAxial"
        label   "Sphere axial divisions"
        type    int
        size    1
        default { 10 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }
    parm {
        name    "splatTransport"
        label   "Splat transport"
        type    string
        size    1
        default { "coverage" }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
        menu {
            "coverage" "coverage"
            "volume" "volume"
        }
    }
    parm {
        name    "cullVolumes"
        label   "Cull volumes"
        type    toggle
        size    1
        default { 1 }
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }
    parm {
        name    "textureQuality"
        label   "Texture quality"
        type    string
        size    1
        default { "high" }
        parmtag { "spare_category" "Textures" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
        menu {
            "high" "high"
            "medium" "medium"
            "low" "low"
        }
    }
    parm {
        name    "reconstruction"
        label   "Reconstruction"
        type    string
        size    1
        default { "off" }
        parmtag { "spare_category" "Reconstruction" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
        menu {
            "off" "off"
            "dlaa" "dlaa"
            "quality" "quality"
            "balanced" "balanced"
            "performance" "performance"
            "ultraperformance" "ultraperformance"
        }
    }
    parm {
        name    "reconstructionModel"
        label   "Reconstruction model"
        type    string
        size    1
        default { "super-resolution" }
        parmtag { "spare_category" "Reconstruction" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
        menu {
            "super-resolution" "super-resolution"
            "ray-reconstruction" "ray-reconstruction"
        }
    }
    parm {
        name    "reconstructionPreset"
        label   "Reconstruction preset"
        type    string
        size    1
        default { "default" }
        parmtag { "spare_category" "Reconstruction" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
        menu {
            "default" "default"
            "stable" "stable"
            "transformer" "transformer"
            "transformer-alt" "transformer-alt"
        }
    }
    parm {
        name    "reconstructionAutoExposure"
        label   "Reconstruction auto-exposure"
        type    toggle
        size    1
        default { 0 }
        parmtag { "spare_category" "Reconstruction" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }
    parm {
        name    "dlssRuntimeDirectory"
        label   "DLSS runtime directory"
        type    string
        size    1
        default { "" }
        parmtag { "spare_category" "Reconstruction" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
    }
}
