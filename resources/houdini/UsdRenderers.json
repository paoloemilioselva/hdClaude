{
    "HdClaudeRendererPlugin": {
        "valid": true,
        "menulabel": "Claude GPU Path Tracer",
        "menupriority": 40,
        "aovsupport": true,
        "needsdepth": false,
        "depthstyle": "linear",
        "defaultpurposes": [ "render" ],
        "drawmodesupport": false,
        "qmlTemplate": "renderstats/HdClaude.qml",
        "viewstats": [ "Samples",
                "Placements",
                "Instancing",
                "TLAS",
                "Per placement",
                "Device memory",
                "Textures" ],
        "statsdatapaths": {
            "Samples"                   : "hud.samples",
            "Placements"                : "hud.placements",
            "Instancing"                : "hud.instancing",
            "TLAS"                      : "hud.tlas",
            "Per placement"             : "hud.perPlacement",
            "Device memory"             : "hud.device",
            "Textures"                  : "hud.textures",

            "totalClockTime"            : "accumulationSeconds",
            "percentDone"               : "percentDone",
            "rendererStage"             : "rendererStage",
            "peakMemory"                : "deviceBytesPeak",
            "totalMemory"               : "deviceBytesUsed"
        }
    }
}
