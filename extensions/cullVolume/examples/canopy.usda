#usda 1.0
(
    doc = """Cull volumes, use case 2: letting sunlight through a canopy.

    The camera stands under a dense canopy, which is above the frame. Two
    sphere cull volumes open holes in it, culling both primary and
    secondary rays (the defaults), so sunlight reaches the ground through
    them as pools of light in shot. The canopy itself is never in frame, so
    culling primary rays as well changes nothing the camera sees directly;
    it is kept on so the scene stays consistent if the camera tilts up.
    """
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Ground"
    {
        double3 xformOp:translate = (0, -0.5, 0)
        float3 xformOp:scale = (40, 0.5, 40)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.35, 0.3, 0.2)]
    }

    def Cube "Canopy" (
        doc = "A stand-in for dense foliage: an opaque slab above the camera."
    )
    {
        double3 xformOp:translate = (0, 12, 0)
        float3 xformOp:scale = (40, 1.5, 40)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.1, 0.35, 0.1)]
    }

    def Xform "Trunks"
    {
        def Cylinder "Trunk1"
        {
            uniform token axis = "Y"
            double height = 12
            double radius = 0.4
            double3 xformOp:translate = (-3, 6, -6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.3, 0.2, 0.1)]
        }

        def Cylinder "Trunk2"
        {
            uniform token axis = "Y"
            double height = 12
            double radius = 0.5
            double3 xformOp:translate = (4, 6, -10)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.3, 0.2, 0.1)]
        }
    }

    def DistantLight "Sun"
    {
        float inputs:angle = 0.53
        float inputs:intensity = 5
        float3 xformOp:rotateXYZ = (-65, 20, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 0.3
        color3f inputs:color = (0.5, 0.7, 1.0)
    }

    def Xform "Gaps"
    {
        def SphereCullVolume "Gap1"
        {
            double radius = 2.5
            double3 xformOp:translate = (-1, 12, -8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereCullVolume "Gap2"
        {
            double radius = 1.5
            double3 xformOp:translate = (3, 12, -4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Camera "Camera"
    {
        float focalLength = 28
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 1.7, 6)
        float3 xformOp:rotateXYZ = (-8, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
