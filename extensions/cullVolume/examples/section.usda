#usda 1.0
(
    doc = """Cull volumes: a plane section through the room of cutaway.usda.

    The cube cutaway is switched off, and a plane cull volume removes
    everything above 2.2 m for every ray, so the camera looks down into the
    room and sunlight enters through the cut, as in an architectural section.

    A plane's inside is the half-space on the negative side of its axis, as
    for UsdGeomCamera's clippingPlanes. The plane is turned over (rotateX =
    180) so that its axis points down, toward what is kept, and its inside
    is everything above it.
    """
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./cutaway.usda@
    ]
    upAxis = "Y"
)

over "World"
{
    over "Cutaway"
    {
        token visibility = "invisible"
    }

    def PlaneCullVolume "Section"
    {
        uniform token axis = "Y"
        double3 xformOp:translate = (0, 2.2, 0)
        float xformOp:rotateX = 180
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }

    over "Camera"
    {
        double3 xformOp:translate = (5, 9, 9)
        float3 xformOp:rotateXYZ = (-40, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
