#usda 1.0
(
    """ Cull volumes: analytic regions of space inside which a renderer
        discards ray intersections with linked geometry, independently for
        primary (camera) rays and secondary rays.

        See ../README.md for the use cases, the exact semantics a renderer
        must implement, and the Hydra mapping.
    """
    subLayers = [
        @usd/schema.usda@,
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "usdCullVolume"
        string libraryPath = "."
        string libraryPrefix = "UsdCullVolume"
        # Codeless while this is a prototype: the UsdImaging adapter reads the
        # attributes by name. A proposal to OpenUSD would generate the classes.
        bool skipCodeGeneration = true
    }
) {
}

class "CullVolume" (
    inherits = </Xformable>
    doc = """Base class for cull volumes.

    A cull volume is a region of space, defined by the concrete subclass in
    its local frame and placed by its transform. For every ray of a kind it
    affects, a renderer discards each intersection of that ray with geometry
    in the `cullLink` collection whose world-space hit point lies in the
    volume's culled region, and the ray continues as if that surface were not
    there. The culled region is the inside of the shape, or, when
    `cullVolume:invert` is true, everything outside it. Rays of a kind the
    volume does not affect, and geometry outside the collection, are
    untouched.

    Unlike backface or frustum culling, which only skip geometry that would
    not have been seen, culling by a cull volume changes the image: it is an
    authored removal of geometry. Rendering can become cheaper as a result,
    because there is less of the scene to trace, but the image is what the
    volume defines, not an approximation of the full scene.

    A cull volume removes geometry from rays; it is not itself geometry. It
    contributes nothing to the image, casts no shadow, and is not part of any
    bounding box, which is why it derives from Xformable and not Boundable or
    Gprim: a renderer that does not know this schema draws nothing for it,
    rather than drawing an opaque shape over the shot.

    Several cull volumes combine as follows. Of the active volumes that
    affect the ray's kind and link the hit geometry, an intersection is
    discarded if it lies inside any volume that is not inverted, or if at
    least one of them is inverted and it lies inside none of the inverted
    ones. Inverted volumes therefore together define the part of the scene
    that is kept (the union of their insides), and volumes that are not
    inverted cut holes in it.

    A cull volume is active when it is visible and its purpose is one the
    render includes, exactly as for any other Imageable. Making it invisible
    is how it is switched off.
    """
    prepend apiSchemas = ["CollectionAPI:cullLink"]
    customData = {
        string className = "CullVolume"
    }
) {
    bool cullVolume:affectsPrimaryRays = true (
        displayGroup = "Cull Volume"
        displayName = "Affects Primary Rays"
        doc = """When true, the volume culls primary rays: rays leaving the
        camera, including their continuation through surfaces the renderer
        treats as not hit (cutout opacity, presence, or another cull volume).
        A reflection, refraction or any other scattered ray is not primary.

        Culling primary rays alone changes what the camera sees and nothing
        else: the culled geometry still shadows, reflects and bounces light.
        """
    )
    bool cullVolume:affectsSecondaryRays = true (
        displayGroup = "Cull Volume"
        displayName = "Affects Secondary Rays"
        doc = """When true, the volume culls secondary rays: every ray that
        is not primary, including shadow (occlusion) rays toward lights and
        all scattered rays.

        Culling secondary rays alone changes how light reaches the scene
        without changing what the camera sees directly.
        """
    )
    bool cullVolume:invert = false (
        displayGroup = "Cull Volume"
        displayName = "Invert"
        doc = """When true, the volume culls everything outside its shape and
        keeps what is inside, instead of culling what is inside. An inverted
        volume defines the region of the scene a render is restricted to,
        for example to focus a look-development render on one area of a
        large set; see the class documentation for how inverted and
        non-inverted volumes combine.
        """
    )
    uniform bool collection:cullLink:includeRoot = 1 (
        customData = {
            bool apiSchemaOverride = true
        }
        doc = """The geometry this volume culls, as a collection. By default
        it includes the whole stage, so a cull volume culls everything inside
        it; excludes, or a membership expression, protect specific prims from
        it, and includes restrict it to specific prims.

        Membership is resolved exactly as UsdLuxLightAPI's `lightLink`
        collection is, and applies to geometry (Gprims and their instances),
        never to lights.
        """
    )
}

class CubeCullVolume "CubeCullVolume" (
    inherits = </CullVolume>
    doc = """A cull volume that is an axis-aligned cube centered at the
    origin of its local frame, with the same parameterization as UsdGeomCube.
    A box of any proportions is a cube with a non-uniform scale in its
    transform, as it is for UsdGeomCube.
    """
    customData = {
        string className = "CubeCullVolume"
    }
) {
    double size = 2.0 (
        displayGroup = "Cull Volume"
        doc = """Length of each edge of the cube, as UsdGeomCube's size: the
        cube spans [-size/2, size/2] on each local axis. A negative size is
        invalid and is reported, and the volume is ignored."""
    )
}

class SphereCullVolume "SphereCullVolume" (
    inherits = </CullVolume>
    doc = """A cull volume that is a sphere centered at the origin of its
    local frame, with the same parameterization as UsdGeomSphere. An
    ellipsoid is a sphere with a non-uniform scale in its transform.
    """
    customData = {
        string className = "SphereCullVolume"
    }
) {
    double radius = 1.0 (
        displayGroup = "Cull Volume"
        doc = """Radius of the sphere, as UsdGeomSphere's radius. A negative
        radius is invalid and is reported, and the volume is ignored."""
    )
}

class PlaneCullVolume "PlaneCullVolume" (
    inherits = </CullVolume>
    doc = """A cull volume that is an infinite half-space bounded by a plane
    through the origin of its local frame, normal to the local `axis`.

    The inside of the volume is the half-space the axis points away from:
    the points whose coordinate along `axis` is negative. This is the same
    convention as UsdGeomCamera's `clippingPlanes`, which cull the side of
    the plane opposite its normal, so the normal points toward what is kept.
    Several planes that are not inverted keep the intersection of their
    positive sides, which is how a convex section, such as a section box, is
    built from planes.
    """
    customData = {
        string className = "PlaneCullVolume"
    }
) {
    uniform token axis = "Z" (
        allowedTokens = ["X", "Y", "Z"]
        displayGroup = "Cull Volume"
        doc = """The local axis the plane is normal to, as UsdGeomPlane's
        axis. The volume's inside is the half-space on the negative side of
        this axis."""
    )
}
