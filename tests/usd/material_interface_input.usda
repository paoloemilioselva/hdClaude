#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# A PointInstancer whose prototype's material reads an interface input on the
# Material prim, doubles it in a shader, and feeds it to a standard_surface's
# base_color. For checking by hand, in usdview, that editing only the Material's
# `inputs:diffColor` -- or the multiplier -- updates every instance live.
# usd_material_edits makes the same edits automatically.
#
# In usdview's interpreter (Window > Interpreter):
#
#   from pxr import Gf, UsdShade
#   m = UsdShade.Material(usdviewApi.stage.GetPrimAtPath("/World/Looks/Doubled"))
#   m.GetInput("diffColor").Set(Gf.Vec3f(0.05, 0.4, 0.05))    # green
#
# or select /World/Looks/Doubled and edit inputs:diffColor in the attribute
# editor.
def Xform "World"
{
    def Camera "camera"
    {
        float2 clippingRange = (0.1, 100)
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        double3 xformOp:translate = (0, 0, 9)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 1
    }

    def PointInstancer "Instancer"
    {
        point3f[] positions = [(-3, 0, 0), (-1, 0, 0), (1, 0, 0), (3, 0, 0)]
        int[] protoIndices = [0, 0, 0, 0]
        rel prototypes = </World/Instancer/Protos/Box>

        def Scope "Protos"
        {
            def Mesh "Box" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-0.45, -0.45, -0.45), (0.45, 0.45, 0.45)]
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
                point3f[] points = [(-0.45, -0.45, -0.45), (0.45, -0.45, -0.45), (0.45, 0.45, -0.45), (-0.45, 0.45, -0.45), (-0.45, -0.45, 0.45), (0.45, -0.45, 0.45), (0.45, 0.45, 0.45), (-0.45, 0.45, 0.45)]
                uniform token subdivisionScheme = "none"
                rel material:binding = </World/Looks/Doubled>
            }
        }
    }

    def Scope "Looks"
    {
        def Material "Doubled"
        {
            color3f inputs:diffColor = (0.4, 0.05, 0.05)
            token outputs:mtlx:surface.connect = </World/Looks/Doubled/Surface.outputs:out>

            def Shader "Twice"
            {
                uniform token info:id = "ND_multiply_color3FA"
                color3f inputs:in1.connect = </World/Looks/Doubled.inputs:diffColor>
                float inputs:in2 = 2
                color3f outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color.connect = </World/Looks/Doubled/Twice.outputs:out>
                float inputs:specular = 0
                token outputs:out
            }
        }
    }
}
