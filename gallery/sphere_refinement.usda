, (0.5, 1), (0.5625, 0.9375), (0.625, 0.9375), (0.625, 1), (0.5625, 1), (0.625, 0.9375), (0.6875, 0.9375), (0.6875, 1), (0.625, 1), (0.6875, 0.9375), (0.75, 0.9375), (0.75, 1), (0.6875, 1), (0.75, 0.9375), (0.8125, 0.9375), (0.8125, 1), (0.75, 1), (0.8125, 0.9375), (0.875, 0.9375), (0.875, 1), (0.8125, 1), (0.875, 0.9375), (0.9375, 0.9375), (0.9375, 1), (0.875, 1), (0.9375, 0.9375), (1, 0.9375), (1, 1), (0.9375, 1)] (
            interpolation = "faceVarying"
        )
        # Catmull-Clark with its boundary interpolated, so the limit surface of
        # this flat grid is the grid itself: refining it adds density without
        # moving it.
        uniform token subdivisionScheme = "catmullClark"
        uniform token interpolateBoundary = "edgeAndCorner"
    }

    def Scope "Looks"
    {
        def Material "bumpy"
        {
            token outputs:mtlx:surface.connect = </World/Looks/bumpy/surface.outputs:out>
            token outputs:mtlx:displacement.connect = </World/Looks/bumpy/displacement.outputs:out>

            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.62, 0.35, 0.22)
                float inputs:specular_roughness = 0.45
                token outputs:out
            }

            # The sphere's own texture coordinates, which only exist because
            # hdClaude generates them: OpenUSD's implicit-surface conversion
            # supplies points and nothing else.
            def Shader "st"
            {
                uniform token info:id = "ND_texcoord_vector2"
                int inputs:index = 0
                float2 outputs:out
            }

            def Shader "height"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @./textures/newzealand_height_map.png@ (
                    colorSpace = "raw"
                )
                float2 inputs:texcoord.connect = </World/Looks/bumpy/st.outputs:out>
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                float outputs:out
            }

            def Shader "displacement"
            {
                uniform token info:id = "ND_displacement_float"
                float inputs:displacement.connect = </World/Looks/bumpy/height.outputs:out>
                float inputs:scale = 0.25
                token outputs:out
            }
        }

        def Material "ground"
        {
            token outputs:mtlx:surface.connect = </World/Looks/ground/surface.outputs:out>

            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.30, 0.31, 0.33)
                float inputs:specular_roughness = 0.6
                token outputs:out
            }
        }
    }
}
