#usda 1.0
(
    metersPerUnit = 1.0
    upAxis = "Y"
    subLayers = [
        @C:\Users\paolo\Desktop\code\OpenPBRShaderPlayground\ShdrPlygrnd\ShdrPlygrnd_OpenPBR.usda@,
    ]
)

# Three of the rig's lights declare `bool inputs:shadow:enable` and give it no
# value, without applying `UsdLuxShadowAPI`. The documented fallback of true
# belongs to that API schema, so a prim which does not apply it has no fallback
# for the property at all -- `GetAttributeFallbackValue` reports the name as not
# in the prim definition, and `Get()` returns nothing.
#
# A valueless attribute that exists is worse than one that does not.
# UsdImaging's attribute data source cannot express "no opinion": it
# zero-initialises, so the property arrives at every render delegate as *false*
# (pxr/usdImaging/usdImaging/dataSourceAttribute.h, GetTypedValue). The rig
# proves it from both sides -- `mainLamp_spill_AL`, which does not declare the
# property at all, arrives with no value and is shadowed; the three that declare
# it without a value arrive as `false` and cast no shadows, lighting the room
# through its walls at every bounce.
#
# So what is authored here is the API schema the asset omitted, not a value.
# That is the smaller claim: it says these lights have shadow controls, which
# they plainly mean to, and lets UsdLux's own fallback supply the rest. Applying
# it makes `Get()` return true and every light in the rig shadow again.
#
# Reported to the asset's author on 2026-09-16. Remove this override once the
# asset applies `ShadowAPI` itself or drops the valueless declaration -- or once
# UsdImaging stops fabricating a value the scene never authored, since nothing in
# hdClaude can tell an unset property from one authored `false`.

over "World"
{
    over "lightRig"
    {
        over "sun_screenRight" (
            prepend apiSchemas = ["ShadowAPI"]
        )
        {
        }

        over "moonLight_screenLFT" (
            prepend apiSchemas = ["ShadowAPI"]
        )
        {
        }

        over "LEDmeetMat" (
            prepend apiSchemas = ["ShadowAPI"]
        )
        {
        }
    }
}
