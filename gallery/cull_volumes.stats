# hdClaude render stats -- cull_volumes.usda
#
# Reported by the renderer through GetRenderStats(), not measured
# from outside: only it knows what it is holding, and only it knows
# the moment a frame holds all of it at once.
#
# Times are total work summed across Hydra's worker threads, so a
# stage can exceed the frame's wall time -- that is threads working
# at once, not an error.
#
# traceMs is the path tracing itself, summed over the progressive
# calls. outsideSeconds is the wall time that trace, ingest and
# publish do not claim: opening the stage, plugin discovery, the
# scene index, writing the EXR and
# tearing the device down, none of which the renderer can see.
#
# Regenerate with: render_gallery.bat -Scene cull_volumes

[scene]
settings              1024 px wide, 1024 spp, 32/update, 8 bounces, subdiv 2
