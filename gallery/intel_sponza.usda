            over "wood_door_01_usd"
            {
                float inputs:metallic.connect = </root/mtl/wood_door_01_usd/wood_door_01_Metalness.outputs:r>
                float inputs:roughness.connect = </root/mtl/wood_door_01_usd/wood_door_01_Roughness.outputs:r>
            }

            over "wood_door_01_Roughness"
            {
                float outputs:r.connect = </root/mtl/wood_door_01_usd/wood_door_01_Roughness/wood_door_01_Roughness.outputs:r>

                over "wood_door_01_Roughness"
                {
                    float outputs:r
                }
            }
        }
    }
}

